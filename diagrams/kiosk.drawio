<mxCell id="2" value="Sau Paid, cảm biến có một máy thì ORDER = DeviceInserted. Chưa Paid thì không" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="230" height="90" as="geometry"/></mxCell>
<mxCell id="3" value="robot_enable = ORDER Locked AND tray_locked AND e_stop false AND payment Paid AND sku reserved · BR-LCK-01." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;size=14;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="300" y="40" width="280" height="90" as="geometry"/></mxCell>
